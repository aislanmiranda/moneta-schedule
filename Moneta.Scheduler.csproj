<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Moneta.Scheduler-ffc82251-eb17-4392-b506-bb8d9d4d396e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.4" />
    <PackageReference Include="Quartz" Version="4.6.0" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="4.6.0" />
  </ItemGroup>

  <!-- The worker reuses the backend's Domain/Application/Infra/Repository projects. Clone
       moneta-backend next to this repo (../moneta-backend); a folder named ../backend also works,
       and /p:BackendDir=... overrides both. -->
  <PropertyGroup>
    <BackendDir Condition="'$(BackendDir)' == '' And Exists('..\moneta-backend\src')">..\moneta-backend</BackendDir>
    <BackendDir Condition="'$(BackendDir)' == ''">..\backend</BackendDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(BackendDir)\src\Moneta.Domain\Moneta.Domain.csproj" />
    <ProjectReference Include="$(BackendDir)\src\Moneta.Application\Moneta.Application.csproj" />
    <ProjectReference Include="$(BackendDir)\src\Moneta.Infra\Moneta.Infra.csproj" />
    <ProjectReference Include="$(BackendDir)\src\Moneta.Repository\Moneta.Repository.csproj" />
  </ItemGroup>
</Project>
